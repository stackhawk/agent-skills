### 1. `data-seed/manifest.yaml`

```yaml
version: 1
name: gateway-api-hawkscan-data-seed
description: Seeds users, orgs, and apps required for authenticated HawkScan against gateway-api.

targets:
  auth-service:
    kind: postgres
    connection: ${AUTH_SERVICE_DB_URL}
  inventory-service:
    kind: postgres
    connection: ${INVENTORY_SERVICE_DB_URL}
  gateway-api:
    kind: http
    base_url: ${GATEWAY_URL:http://localhost:9000}

prerequisites:
  env:
    - name: AUTH_SERVICE_DB_URL
      description: "Postgres DSN for auth-service — e.g. postgres://user:pass@localhost:5432/auth_dev"
    - name: INVENTORY_SERVICE_DB_URL
      description: "Postgres DSN for inventory-service — e.g. postgres://user:pass@localhost:5432/inventory_dev"
    - name: GATEWAY_URL
      description: "Base URL for gateway-api — e.g. http://localhost:9000"
    - name: TEST_USER
      description: "Email address of the test user to create"
    - name: TEST_PASS
      description: "Password for the test user (stored in .data-seed-credentials.env, gitignored)"
  services:
    - name: auth-service
      url: ${AUTH_SERVICE_URL:http://localhost:8080}
      check: http_ready
    - name: inventory-service
      url: ${INVENTORY_SERVICE_URL:http://localhost:9090}
      check: http_ready
    - name: gateway-api
      url: ${GATEWAY_URL:http://localhost:9000}
      check: http_ready
  notes: |
    Start the stack before running: `docker-compose up -d` or your env's equivalent.
    Ensure AUTH_SERVICE_DB_URL and INVENTORY_SERVICE_DB_URL are set in your shell or
    sourced from .data-seed-credentials.env before invoking the Runner.
    See data-seed/credentials.env.example for a template.

steps:
  - id: auth-orgs
    description: Create test organization in auth-service
    service: auth-service
    type: sql
    file: auth-service/001-orgs.sql
    target: auth-service
    idempotency: check_sql
    check_sql: "SELECT 1 FROM organizations WHERE name = 'Example Test Org';"
    creates: [ "org:example-test-org" ]

  - id: auth-users
    description: Create test user in auth-service
    service: auth-service
    type: sql
    file: auth-service/002-users.sql
    target: auth-service
    depends_on: [ auth-orgs ]
    idempotency: check_sql
    check_sql: "SELECT 1 FROM users WHERE email = 'test-owner@example.com';"
    creates: [ "user:test-owner@example.com" ]

  - id: auth-memberships
    description: Link test user to test org with OWNER role
    service: auth-service
    type: sql
    file: auth-service/003-memberships.sql
    target: auth-service
    depends_on: [ auth-users ]
    idempotency: check_sql
    check_sql: >
      SELECT 1 FROM user_org_memberships
      WHERE user_id = '00000000-0000-0000-0000-000000000002'
        AND org_id  = '00000000-0000-0000-0000-000000000001';
    creates: [ "membership:test-owner@example.com->example-test-org" ]

  - id: inventory-apps
    description: Create scannable app in inventory-service, owned by test org
    service: inventory-service
    type: sql
    file: inventory-service/001-apps.sql
    target: inventory-service
    depends_on: [ auth-orgs ]
    idempotency: check_sql
    check_sql: "SELECT 1 FROM applications WHERE name = 'target-app-1';"
    creates: [ "app:target-app-1" ]

  - id: gateway-link
    description: Link app to Development env via gateway-api REST API
    service: gateway-api
    type: http
    file: gateway-api/001-link-app-to-env.http
    target: gateway-api
    depends_on: [ auth-memberships, inventory-apps ]
    idempotency: check_http
    check_http:
      method: GET
      path: /v1/apps/target-app-1/envs
      expect_status: 200
      expect_jq: ".envs | length > 0"
    creates: [ "env-link:target-app-1/Development" ]

outputs:
  TEST_USER: test-owner@example.com
  TEST_PASS: ExampleSeedPass1!
  TEST_PASSWORD: ExampleSeedPass1!
  TEST_ORG_ID: 00000000-0000-0000-0000-000000000001
  TEST_APP_ID: 00000000-0000-0000-0000-000000000010
  GATEWAY_LOGIN_URL: ${GATEWAY_URL}/login
```

### 2. `data-seed/auth-service/001-orgs.sql`

```sql
-- Data seed: create Example Test Org in auth-service
-- Idempotent via INSERT ... ON CONFLICT DO NOTHING

INSERT INTO organizations (id, name, slug, created_at)
VALUES (
  '00000000-0000-0000-0000-000000000001',
  'Example Test Org',
  'example-test-org',
  CURRENT_TIMESTAMP
)
ON CONFLICT (id) DO NOTHING;
```

### 3. `data-seed/auth-service/002-users.sql`

The password hash is **pre-computed at skill emission time** using bcrypt (rounds=12) and
embedded as a string literal. This ensures compatibility with `BCryptPasswordEncoder`
(Spring Security and equivalents), which uses the `$2a$` prefix — incompatible with
Postgres `pgcrypto.crypt()`, which produces the older `$2$` format. The plaintext
password lives only in `.data-seed-credentials.env` (gitignored) and is never stored
in a checked-in file. See `idempotency-patterns.md` §Password-Hash Seeding for the
emit-time hashing strategy.

```sql
-- Data seed: create test user in auth-service.
-- Hash computed at emit time (see idempotency-patterns.md §Password-Hash Seeding).
-- Plaintext lives in .data-seed-credentials.env as TEST_PASS.
-- Idempotent via INSERT ... ON CONFLICT DO NOTHING

INSERT INTO users (id, email, password_hash, created_at)
VALUES (
  '00000000-0000-0000-0000-000000000002',
  'test-owner@example.com',
  '$2a$12$<emit-time-computed-bcrypt-hash>',
  CURRENT_TIMESTAMP
)
ON CONFLICT (email) DO NOTHING;
```

If your application uses Postgres-native bcrypt verification via `pgcrypto` (rare —
only applicable when the app calls `crypt()` directly rather than a language-level
`BCryptPasswordEncoder`), you can instead supply the password via psql variable
substitution:

```sql
-- Fallback: only if your app verifies with pgcrypto crypt(), NOT BCryptPasswordEncoder.
-- Supply password via: psql -v test_pass="$TEST_PASS" -f 002-users.sql
-- Requires: pgcrypto extension (CREATE EXTENSION IF NOT EXISTS pgcrypto;)
INSERT INTO users (id, email, password_hash, created_at)
VALUES (
  '00000000-0000-0000-0000-000000000002',
  'test-owner@example.com',
  crypt(:'test_pass', gen_salt('bf')),
  CURRENT_TIMESTAMP
)
ON CONFLICT (email) DO NOTHING;
```

### 4. `data-seed/auth-service/003-memberships.sql`

```sql
-- Data seed: link user to org in auth-service
-- Idempotent via INSERT ... ON CONFLICT DO NOTHING

INSERT INTO user_org_memberships (user_id, org_id, role)
VALUES (
  '00000000-0000-0000-0000-000000000002',
  '00000000-0000-0000-0000-000000000001',
  'OWNER'
)
ON CONFLICT (user_id, org_id) DO NOTHING;
```

### 5. `data-seed/inventory-service/001-apps.sql`

```sql
-- Data seed: create target-app-1 in inventory-service, owned by Example Test Org
-- Idempotent via INSERT ... ON CONFLICT DO NOTHING

INSERT INTO applications (id, name, org_id, created_at)
VALUES (
  '00000000-0000-0000-0000-000000000010',
  'target-app-1',
  '00000000-0000-0000-0000-000000000001',
  CURRENT_TIMESTAMP
)
ON CONFLICT (name, org_id) DO NOTHING;
```

### 6. `data-seed/gateway-api/001-link-app-to-env.http`

REST Client format (compatible with VS Code REST Client, IntelliJ HTTP Client).

```http
### Login to obtain session cookie
POST {{GATEWAY_URL}}/login
Content-Type: application/json

{
  "email": "{{TEST_USER}}",
  "password": "{{TEST_PASS}}"
}

### Create Development env for target-app-1 (idempotent via PUT)
PUT {{GATEWAY_URL}}/v1/apps/target-app-1/envs/Development
Content-Type: application/json
Cookie: session={{SESSION_ID}}

{
  "host": "http://localhost:9000",
  "applicationId": "00000000-0000-0000-0000-000000000010"
}
```

`{{SESSION_ID}}` is populated by the Runner from the `Set-Cookie` header of the
login response. When replaying manually, extract it with the `curl` snippet in the
Manual Replay section below.

### 7. `data-seed/credentials.env.example`

```
# Copy this file to .data-seed-credentials.env and fill in real values.
# .data-seed-credentials.env is gitignored — never commit it.
# Source with: set -a; . ./.data-seed-credentials.env; set +a

TEST_USER=test-owner@example.com
TEST_PASS=<set-real-password>
TEST_ORG_ID=00000000-0000-0000-0000-000000000001
TEST_APP_ID=00000000-0000-0000-0000-000000000010
GATEWAY_LOGIN_URL=http://localhost:9000/login

# Database URLs (set per dev environment)
AUTH_SERVICE_DB_URL=postgres://auth_user:auth_pass@localhost:5432/auth_dev
INVENTORY_SERVICE_DB_URL=postgres://inv_user:inv_pass@localhost:5432/inventory_dev

# Service base URLs (override defaults if your ports differ)
AUTH_SERVICE_URL=http://localhost:8080
INVENTORY_SERVICE_URL=http://localhost:9090
GATEWAY_URL=http://localhost:9000
```

