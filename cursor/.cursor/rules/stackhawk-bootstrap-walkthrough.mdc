```bash
# Confirm org exists
psql "${EYAS_DB_URL}" -c "SELECT name FROM organizations WHERE id='00000000-0000-0000-0000-000000000001';"

# Confirm user exists
psql "${EYAS_DB_URL}" -c "SELECT email FROM users WHERE email='hawkscan-test@example.com';"

