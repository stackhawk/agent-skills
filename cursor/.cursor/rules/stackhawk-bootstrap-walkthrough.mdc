### 1. `bootstrap/manifest.yaml`

```yaml
version: 1
name: falcon-hawkscan-bootstrap
description: Seeds users, orgs, and apps required for authenticated HawkScan against falcon.

prerequisites:
  env:
    - name: EYAS_DB_URL
      description: "Postgres connection string for eyas — e.g. postgres://user:pass@localhost:5432/eyas_dev"
    - name: YARAK_DB_URL
      description: "Postgres connection string for yarak — e.g. postgres://user:pass@localhost:5432/yarak_dev"
    - name: FALCON_URL
      description: "Base URL for falcon — e.g. http://localhost:9000"
    - name: TEST_USER
      description: "Email address of the test user to create"
    - name: TEST_PASS
      description: "Password for the test user (stored in .bootstrap-credentials.env, gitignored)"
  services:
    - name: eyas
      url: ${EYAS_URL:http://localhost:8080}
      check: http_ready
    - name: yarak
      url: ${YARAK_URL:http://localhost:9090}
      check: http_ready
    - name: falcon
      url: ${FALCON_URL:http://localhost:9000}
      check: http_ready
  notes: |
    Start the stack before running: `docker-compose up -d` or your env's equivalent.
    Ensure EYAS_DB_URL and YARAK_DB_URL are set in your shell or sourced from
    .bootstrap-credentials.env before invoking the Runner.
    See bootstrap/credentials.env.example for a template.

steps:
  - id: eyas-orgs
    description: Create test organization in eyas
    service: eyas
    type: sql
    file: eyas/001-orgs.sql
    target:
      kind: postgres
      connection: ${EYAS_DB_URL}
    creates: [ "org:hawkscan-test-org" ]
    idempotency:
      check_sql: "SELECT 1 FROM organizations WHERE name = 'HawkScan Test Org';"

  - id: eyas-users
    description: Create test user in eyas with bcrypt-hashed password
    service: eyas
    type: sql
    file: eyas/002-users.sql
    target:
      kind: postgres
      connection: ${EYAS_DB_URL}
    depends_on: [ eyas-orgs ]
    creates: [ "user:hawkscan-test@example.com" ]
    idempotency:
      check_sql: "SELECT 1 FROM users WHERE email = 'hawkscan-test@example.com';"

  - id: eyas-memberships
    description: Link test user to test org with OWNER role
    service: eyas
    type: sql
    file: eyas/003-memberships.sql
    target:
      kind: postgres
      connection: ${EYAS_DB_URL}
    depends_on: [ eyas-users ]
    creates: [ "membership:hawkscan-test@example.com->hawkscan-test-org" ]
    idempotency:
      check_sql: >
        SELECT 1 FROM user_org_memberships
        WHERE user_id = '00000000-0000-0000-0000-000000000002'
          AND org_id  = '00000000-0000-0000-0000-000000000001';

  - id: yarak-apps
    description: Create scannable app in yarak, owned by test org
    service: yarak
    type: sql
    file: yarak/001-apps.sql
    target:
      kind: postgres
      connection: ${YARAK_DB_URL}
    depends_on: [ eyas-orgs ]
    creates: [ "app:target-app-1" ]
    idempotency:
      check_sql: "SELECT 1 FROM applications WHERE name = 'target-app-1';"

  - id: falcon-link
    description: Link app to Development env via falcon REST API (no DB; goes through API gateway)
    service: falcon
    type: http
    file: falcon/001-link-app-to-env.http
    target:
      kind: http
      base_url: ${FALCON_URL:http://localhost:9000}
    depends_on: [ eyas-memberships, yarak-apps ]
    creates: [ "env-link:target-app-1/Development" ]
    idempotency:
      check_http:
        method: GET
        path: /v1/apps/target-app-1/envs
        expect_status: 200
        expect_jq: ".envs | length > 0"

  - id: beak-auth-users-and-keys
    description: Create auth_user and api_key rows in beak for the test user
    service: beak
    type: sql
    file: beak/001-auth-users-and-keys.sql
    target:
      kind: postgres
      connection: ${BEAK_DB_URL}
    depends_on: [ eyas-users ]
    creates: [ "auth_user:hawkscan-test@example.com", "apikey:hawkscan-scan-key" ]
    idempotency:
      check_sql: "SELECT 1 FROM auth_user WHERE external_user_id = '00000000-0000-0000-0000-000000000002';"

  - id: beak-stackhawk-users
    description: Create stackhawk_user with bcrypt-hashed password in beak (enables usernamePassword auth)
    service: beak
    type: sql
    file: beak/002-stackhawk-user.sql
    target:
      kind: postgres
      connection: ${BEAK_DB_URL}
    depends_on: [ beak-auth-users-and-keys ]
    creates: [ "password-user:owner@hawkscan.test", "password-user:member@hawkscan.test", "password-user:viewer@hawkscan.test" ]
    idempotency:
      on_conflict_do_nothing

outputs:
  TEST_USER: hawkscan-test@example.com
  TEST_PASS: HawkScanTest1!
  TEST_PASSWORD: HawkScanTest1!
  TEST_ORG_ID: 00000000-0000-0000-0000-000000000001
  TEST_APP_ID: 00000000-0000-0000-0000-000000000010
  FALCON_LOGIN_URL: ${FALCON_URL}/login
```

