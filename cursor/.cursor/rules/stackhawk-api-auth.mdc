## Reusable Helper Script

Write the block below to a temp file and source it. The helper handles authentication,
token caching (in-memory only — no secrets written to disk), `401` auto-retry,
and full pagination for both V1 and V2 endpoints.

```bash
# Write to a temp file and source it:
#   _hawk_lib=$(mktemp /tmp/hawk_lib.XXXXXX.sh)
#   cat > "${_hawk_lib}" << 'HAWK_LIB'
#   ... (paste block below) ...
#   HAWK_LIB
#   source "${_hawk_lib}"

# -----------------------------------------------------------------------
# StackHawk API helper library
# Requires: curl, jq, HAWK_API_KEY in environment
# -----------------------------------------------------------------------

_HAWK_TOKEN=""
_HAWK_BASE_URL="https://api.stackhawk.com"

# _hawk_auth — authenticate and cache token in _HAWK_TOKEN
_hawk_auth() {
  if [[ -z "${HAWK_API_KEY:-}" ]]; then
    echo "ERROR: HAWK_API_KEY is not set. Generate a key at app.stackhawk.com → Settings → API Keys." >&2
    return 1
  fi

  local response
  response=$(curl -s -w "\n%{http_code}" \
    -H "X-ApiKey: ${HAWK_API_KEY}" \
    "${_HAWK_BASE_URL}/api/v1/auth/login")

  local body http_code
  body=$(printf '%s' "${response}" | head -n -1)
  http_code=$(printf '%s' "${response}" | tail -n 1)

  if [[ "${http_code}" != "200" ]]; then
    echo "ERROR: Auth failed with HTTP ${http_code}. Check HAWK_API_KEY." >&2
    return 1
  fi

  _HAWK_TOKEN=$(printf '%s' "${body}" | jq -r '.token // empty')

  if [[ -z "${_HAWK_TOKEN}" ]]; then
    echo "ERROR: Auth response did not contain a token. Response: ${body}" >&2
    return 1
  fi
}

# hawk_api — make an authenticated API call with automatic 401 re-auth
#
# Usage:
#   hawk_api <METHOD> <PATH> [EXTRA_CURL_ARGS...]
#
# Examples:
#   hawk_api GET /api/v1/scan/${ORG_ID}
#   hawk_api GET "/api/v2/org/${ORG_ID}/apps?pageSize=100"
#   hawk_api POST /api/v1/org/${ORG_ID}/tag -H "Content-Type: application/json" -d '{"name":"ci"}'
#
# Returns: raw JSON response body on stdout; exits non-zero on failure
hawk_api() {
  local method="${1:?hawk_api requires METHOD as first argument}"
  local path="${2:?hawk_api requires PATH as second argument}"
  shift 2
  local extra_args=("$@")

  # Authenticate if no token is cached yet
  if [[ -z "${_HAWK_TOKEN}" ]]; then
    _hawk_auth || return 1
  fi

  local response http_code body
  response=$(curl -s -w "\n%{http_code}" \
    -X "${method}" \
    -H "Authorization: Bearer ${_HAWK_TOKEN}" \
    -H "Accept: application/json" \
    "${extra_args[@]}" \
    "${_HAWK_BASE_URL}${path}")

  body=$(printf '%s' "${response}" | head -n -1)
  http_code=$(printf '%s' "${response}" | tail -n 1)

  # Auto-retry once on 401 (expired token)
  if [[ "${http_code}" == "401" ]]; then
    _HAWK_TOKEN=""
    _hawk_auth || return 1

    response=$(curl -s -w "\n%{http_code}" \
      -X "${method}" \
      -H "Authorization: Bearer ${_HAWK_TOKEN}" \
      -H "Accept: application/json" \
      "${extra_args[@]}" \
      "${_HAWK_BASE_URL}${path}")

    body=$(printf '%s' "${response}" | head -n -1)
    http_code=$(printf '%s' "${response}" | tail -n 1)
  fi

  if [[ "${http_code}" == "401" ]]; then
    echo "ERROR: Still receiving 401 after re-auth. Check HAWK_API_KEY scopes." >&2
    return 1
  fi

  if [[ "${http_code}" == "403" ]]; then
    echo "ERROR: HTTP 403 — insufficient permissions. Check API key scopes at app.stackhawk.com → Settings → API Keys." >&2
    return 1
  fi

  if [[ "${http_code}" -lt 200 || "${http_code}" -gt 299 ]]; then
    echo "ERROR: HTTP ${http_code} from ${method} ${path}. Body: ${body}" >&2
    return 1
  fi

  printf '%s' "${body}"
}

# hawk_api_all_pages — auto-paginate an endpoint and collect all results
#
# Detects V1 vs V2 pagination automatically based on response shape:
#   V1: query params pageSize + pageToken (integer), response has nextPageToken
#   V2: query params pageSize + page (string, e.g. "p_abc") + pageToken,
#       response has currentPage, hasNext, hasPrev
#
# Usage:
#   hawk_api_all_pages <PATH_WITHOUT_PAGINATION_PARAMS> <RESULTS_KEY> [PAGE_SIZE]
#
# Arguments:
#   PATH_WITHOUT_PAGINATION_PARAMS  — base path, no pageSize/pageToken params
#   RESULTS_KEY                     — jq key that holds the array of results
#                                     (e.g. "scans", "applications", "findings")
#   PAGE_SIZE                       — optional, defaults to 100
#
# Returns: JSON array of all collected items on stdout
#
# Examples:
#   hawk_api_all_pages "/api/v1/scan/${ORG_ID}" "scans"
#   hawk_api_all_pages "/api/v2/org/${ORG_ID}/apps" "applications" 50
hawk_api_all_pages() {
  local base_path="${1:?hawk_api_all_pages requires base PATH}"
  local results_key="${2:?hawk_api_all_pages requires RESULTS_KEY}"
  local page_size="${3:-100}"

  local all_results="[]"
  local separator=""
  local page_token=""
  local is_v2=""
  local first_page=true

  while true; do
    # Build URL with pagination parameters
    local url
    if [[ "${first_page}" == "true" ]]; then
      # First request: add pageSize only; detect API version from response
      if [[ "${base_path}" == *"?"* ]]; then
        url="${base_path}&pageSize=${page_size}"
      else
        url="${base_path}?pageSize=${page_size}"
      fi
    elif [[ "${is_v2}" == "true" ]]; then
      # V2: pageSize + page (cursor string) + pageToken
      if [[ "${base_path}" == *"?"* ]]; then
        url="${base_path}&pageSize=${page_size}&page=${page_token}"
      else
        url="${base_path}?pageSize=${page_size}&page=${page_token}"
      fi
    else
      # V1: pageSize + pageToken (integer offset)
      if [[ "${base_path}" == *"?"* ]]; then
        url="${base_path}&pageSize=${page_size}&pageToken=${page_token}"
      else
        url="${base_path}?pageSize=${page_size}&pageToken=${page_token}"
      fi
    fi

    local page_response
    page_response=$(hawk_api GET "${url}") || return 1

    # Detect pagination version on first page
    if [[ "${first_page}" == "true" ]]; then
      first_page=false
      local has_current_page
      has_current_page=$(printf '%s' "${page_response}" | jq -r 'has("currentPage")')
      if [[ "${has_current_page}" == "true" ]]; then
        is_v2="true"
      fi
    fi

    # Extract items from this page and append to accumulated results
    local page_items
    page_items=$(printf '%s' "${page_response}" | jq -c ".${results_key} // []")
    all_results=$(printf '%s\n%s' "${all_results}" "${page_items}" | \
      jq -sc 'add // []')

    # Determine whether there are more pages
    if [[ "${is_v2}" == "true" ]]; then
      local has_next
      has_next=$(printf '%s' "${page_response}" | jq -r '.hasNext // false')
      if [[ "${has_next}" != "true" ]]; then
        break
      fi
      page_token=$(printf '%s' "${page_response}" | jq -r '.currentPage // empty')
      if [[ -z "${page_token}" ]]; then
        echo "ERROR: V2 response missing currentPage for next-page cursor." >&2
        return 1
      fi
    else
      page_token=$(printf '%s' "${page_response}" | jq -r '.nextPageToken // empty')
      if [[ -z "${page_token}" || "${page_token}" == "null" ]]; then
        break
      fi
    fi
  done

  printf '%s' "${all_results}"
}
```

### Usage Examples After Sourcing

```bash
# Authenticate (happens automatically on first call, but can be called explicitly)
_hawk_auth

# Single call — get org info
hawk_api GET /api/v1/org/${ORG_ID}

# Single call — list apps (first page only)
hawk_api GET "/api/v2/org/${ORG_ID}/apps?pageSize=20"

# Paginated — collect ALL scans across all pages
all_scans=$(hawk_api_all_pages "/api/v1/scan/${ORG_ID}" "scans")
echo "${all_scans}" | jq 'length'

# Paginated — collect ALL apps (V2 endpoint)
all_apps=$(hawk_api_all_pages "/api/v2/org/${ORG_ID}/apps" "applications")
echo "${all_apps}" | jq '.[].name'

# POST with body
hawk_api POST "/api/v1/org/${ORG_ID}/tag" \
  -H "Content-Type: application/json" \
  -d '{"name": "ci", "color": "blue"}'
```

