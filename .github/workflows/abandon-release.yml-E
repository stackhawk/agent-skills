# Frees a release number whose publish can't be finished: the merged change itself breaks the release
# (validate, the GitHub Release or the marketplace sync), so a re-run fails again and every later main
# run stops at resolve on the claim. Run it with the number the failed run claimed (the failed
# run's resolve or claim job log names it), then merge the fix: its main run releases the next number.
# Make sure the failed run is over first.
#
# Only a person starts it (workflow_dispatch), only on main, as ci-deploy-preprod with the release
# App's token: only the App and autodeploy may touch tags. It shares the release workflow's
# concurrency group, so it waits for a run that is still releasing.
name: Abandon release
on:
  workflow_dispatch:
    inputs:
      version:
        description: 'The release number a failed main run claimed, such as 2.7.2'
        required: true
        type: string
concurrency:
  group: Release-main
  cancel-in-progress: false
  queue: max
permissions:
  contents: read
jobs:
  abandon:
    if: github.ref_name == 'main'
    runs-on: biodome-ci-arm-2cpu
    timeout-minutes: 10
    permissions:
      contents: read
      id-token: write
    env:
      CI_ROLES: ${{ vars.CI_ROLES }}
    steps:
      - name: Biodome job setup
        uses: ./../../../../../home/runner/.github/actions/biodome-setup-v2
      - name: CI identity (ci-deploy-preprod)
        run: |
          biodome-rs aws assume ci-deploy-preprod --profile deploy --source oidc
          echo "AWS_PROFILE=deploy" >> "$GITHUB_ENV"
      - name: Release App token
        run: |
          token="$(biodome ci github-app-token --repository "${GITHUB_REPOSITORY#*/}" --permission contents=write)"
          echo "::add-mask::$token"
          echo "GH_TOKEN=$token" >> "$GITHUB_ENV"
      - name: Abandon the release number
        run: biodome-rs ci version abandon "$VERSION"
        env:
          VERSION: ${{ inputs.version }}
