{
  "name": "stackhawk",
  "interface": {
    "displayName": "StackHawk Agent Skills",
    "shortDescription": "Dynamic application and API security testing (DAST) powered by HawkScan."
  },
  "plugins": [
    {
      "name": "hawkscan",
      "source": { "source": "local", "path": "./plugins/hawkscan" },
      "policy": { "installation": "AVAILABLE" },
      "category": "Security"
    },
    {
      "name": "stackhawk-api",
      "source": { "source": "local", "path": "./plugins/api" },
      "policy": { "installation": "AVAILABLE" },
      "category": "Security"
    },
    {
      "name": "hawkscan-ci",
      "source": { "source": "local", "path": "./plugins/hawkscan-ci" },
      "policy": { "installation": "AVAILABLE" },
      "category": "Security"
    },
    {
      "name": "stackhawk-data-seed",
      "source": { "source": "local", "path": "./plugins/stackhawk-data-seed" },
      "policy": { "installation": "AVAILABLE" },
      "category": "Security"
    },
    {
      "name": "wingman",
      "source": { "source": "local", "path": "./plugins/wingman" },
      "policy": { "installation": "AVAILABLE" },
      "category": "Security"
    }
  ]
}
