#!/usr/bin/env bash
# PostToolUse hook for hawkscan plugin
# Fires after Bash tool use. If the command just made a git commit, outputs the
# commit SHA and instructs the agent to run HawkScan against it.

set -euo pipefail

# The hook system passes the PostToolUse payload on stdin as JSON. The Bash command
# is at .tool_input.command. The payload also carries the tool's output
# (.tool_response), which must never be searched for a commit.
if [ -t 0 ]; then
  # No stdin (interactive terminal) — not a tool use context
  exit 0
fi
tool_input=$(cat)

# Extract the command that was run. No command means nothing to match: never fall
# back to the whole payload.
if command -v jq >/dev/null 2>&1; then
  command_text=$(printf '%s' "$tool_input" | jq -r '(.tool_input | objects | .command | strings) // empty' 2>/dev/null || true)
else
  # Best effort without jq: the first "command" string after "tool_input" (which
  # precedes tool_response in the payload), with the common JSON escapes undone.
  command_text=$(printf '%s' "$tool_input" \
    | sed -E 's/^.*"tool_input"[[:space:]]*:[[:space:]]*\{//' \
    | grep -oE '"command"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"' | head -1 \
    | sed -E 's/^"command"[[:space:]]*:[[:space:]]*"//; s/"$//; s/\\n/\
/g; s/\\t/	/g; s/\\"/"/g; s/\\\\/\\/g' || true)
fi

if [ -z "$command_text" ]; then
  exit 0
fi

# Is the command a real `git commit`? Drop heredoc bodies (text, not commands), unquote
# strings with their blanks, newlines and separators encoded as \021-\031 (so a commit
# message or `echo "git commit"` cannot start a command), split into simple commands, and
# require one to start with: [VAR=x ...] git [-C dir | -c k=v | --no-pager | -p | -P ...] commit
simple_commands=$(printf '%s\n' "$command_text" \
  | awk '
      n { line = $0; if (tabs[k]) sub(/^\t+/, "", line); if (line == delims[k] && ++k > n) n = 0; next }
      {
        print; rest = " " $0; k = 1
        while (match(rest, /<<-?[ \t]*[^ \t;&|<>()]+/)) {
          op = substr(rest, RSTART, RLENGTH); before = substr(rest, RSTART - 1, 1)
          rest = substr(rest, RSTART + RLENGTH)
          if (before == "<") continue
          d = op; sub(/^<<-?[ \t]*/, "", d); gsub(/[\\"\047]/, "", d)
          delims[++n] = d; tabs[n] = (substr(op, 3, 1) == "-")
        }
      }' \
  | awk '
      {
        s = $0; out = ""
        for (i = 1; i <= length(s); i++) {
          c = substr(s, i, 1); lit = 0
          if (q == "" && (c == "\"" || c == "\047")) { q = c; continue }
          if (c == q) { q = ""; continue }
          if (c == "\\" && q != "\047" && i < length(s)) { c = substr(s, ++i, 1); lit = 1 }
          if ((q != "" || lit) && (k = index(" \t;|&()`", c))) c = substr("\021\022\023\024\025\026\027\030", k, 1)
          out = out c
        }
        printf "%s%s", out, (q == "" ? "\n" : "\031")
      }' \
  | sed -E 's/&&|\|\|/;/g' \
  | tr ';|&()`' '\n\n\n\n\n\n')
git_commit_re='^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*([^[:space:]]*/)?git([[:space:]]+(-[Cc][[:space:]]+[^[:space:]]+|--no-pager|-[pP]))*[[:space:]]+commit([[:space:]]|$)'
commit_line=$(printf '%s\n' "$simple_commands" | grep -E "$git_commit_re" | tail -n 1 || true)
if [ -z "$commit_line" ]; then
  exit 0
fi

# Resolve the repo the commit went to: follow `git -C <dir>` (decoded, with a leading ~
# expanded). A commit that names its repository another way (GIT_DIR=, GIT_WORK_TREE=)
# is not reported.
read -ra words <<< "$commit_line"
git_args=(-C .)
prev=""
for word in "${words[@]}"; do
  case "$prev" in
    -C)
      dir=$(printf '%s' "$word" | tr '\021-\031' ' \t;|&()`\n')
      case "$dir" in
        "~") dir=$HOME ;;
        "~/"*) dir=$HOME/${dir#"~/"} ;;
      esac
      git_args+=(-C "$dir")
      ;;
    -c) ;;
    *)
      case "$word" in
        GIT_DIR=*|GIT_WORK_TREE=*) exit 0 ;;
        commit) break ;;
      esac
      ;;
  esac
  prev=$word
done

# Report only a commit that was just made: the newest commit entry (commit, amend, merge)
# in that repo's HEAD reflog from the last 10 minutes. Later entries from the same command
# (a checkout, a pull --rebase) may follow it; when a rebase on the same branch rewrote
# it, report HEAD. No such entry (a failed commit with no other recent commit, a repo
# outside a git checkout) keeps the hook silent.
reflog=$(git "${git_args[@]}" reflog -n 50 --date=unix --format='%gd %H %gs' 2>/dev/null || true)
now=$(date +%s)
commit_sha=""
moved=false
rebased=false
while read -r selector sha subject; do
  entry_time=${selector#*@\{}
  entry_time=${entry_time%\}}
  case "$entry_time" in
    ''|*[!0-9]*) break ;;
  esac
  if [ $(( now - entry_time )) -gt 600 ]; then
    break
  fi
  case "$subject" in
    commit*) commit_sha=$sha; break ;;
    checkout:*) moved=true ;;
    *rebase*finish*) rebased=true ;;
  esac
done <<< "$reflog"
if [ -z "$commit_sha" ]; then
  exit 0
fi
if [ "$rebased" = true ] && [ "$moved" = false ]; then
  commit_sha=$(git "${git_args[@]}" rev-parse HEAD 2>/dev/null || echo "$commit_sha")
fi
short_sha=$(git "${git_args[@]}" rev-parse --short "$commit_sha" 2>/dev/null || echo "unknown")

# Check for scan evidence already in this session (avoid double-triggering)
# Look for scan-related commits made after our commit
scan_evidence="false"
if [ -f "findings.json" ] || [ -f "hawk_scan_output.json" ]; then
  scan_evidence="true"
fi
# Check if there's a very recent scan-related commit (within last 5 minutes)
if git "${git_args[@]}" log --since="5 minutes ago" --oneline 2>/dev/null | grep -iE "scan|hawkscan|security fix|vulnerability|resolve CWE" >/dev/null 2>&1; then
  scan_evidence="true"
fi

if [ "$scan_evidence" = "true" ]; then
  exit 0
fi

# Build the context injection
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context_text="<hawkscan-post-commit>
Code committed at ${short_sha} (${commit_sha}). Invoke hawkscan:hawkscan to scan this commit. The scan results will be associated with commit ${short_sha}.

If the application is running and HAWK_API_KEY is set, run the scan now. Fix all findings, commit fixes, then rescan to verify.
</hawkscan-post-commit>"

escaped=$(escape_for_json "$context_text")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
