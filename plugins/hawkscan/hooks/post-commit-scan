#!/usr/bin/env bash
# PostToolUse hook for hawkscan plugin
# Fires after Bash tool use. If the command was a git commit, outputs the
# commit SHA and instructs the agent to run HawkScan against it.

set -euo pipefail

# The hook system passes the PostToolUse payload on stdin as JSON. The Bash command
# is at .tool_input.command. The payload also carries the tool's output
# (.tool_response), which must never be searched for a commit.
if [ -t 0 ]; then
  # No stdin (interactive terminal) — not a tool use context
  exit 0
fi
tool_input=$(cat)

# Extract the command that was run. No command means nothing to match: never fall
# back to the whole payload.
if command -v jq >/dev/null 2>&1; then
  command_text=$(printf '%s' "$tool_input" | jq -r '(.tool_input | objects | .command | strings) // empty' 2>/dev/null || true)
else
  # Best effort without jq: the first "command" string after "tool_input" (which
  # precedes tool_response in the payload), with the common JSON escapes undone.
  command_text=$(printf '%s' "$tool_input" \
    | sed -E 's/^.*"tool_input"[[:space:]]*:[[:space:]]*\{//' \
    | grep -oE '"command"[[:space:]]*:[[:space:]]*"([^"\\]|\\.)*"' | head -1 \
    | sed -E 's/^"command"[[:space:]]*:[[:space:]]*"//; s/"$//; s/\\n/;/g; s/\\"/"/g; s/\\\\/\\/g' || true)
fi

if [ -z "$command_text" ]; then
  exit 0
fi

# Is the command a real `git commit`? Replace quoted strings with a placeholder (so a
# commit message or `echo "git commit"` cannot match), split into simple commands,
# and require one to start with: [VAR=x ...] git [global options] commit
simple_commands=$(printf '%s' "$command_text" \
  | tr '\n' '\001' \
  | sed -E "s/\"[^\"]*\"/Q/g; s/'[^']*'/Q/g" \
  | tr '\001' ';' \
  | sed -E 's/&&|\|\|/;/g' \
  | tr ';|&()`' '\n\n\n\n\n\n')
git_commit_re='^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*([^[:space:]]*/)?git([[:space:]]+(-C[[:space:]]+[^[:space:]]+|-c[[:space:]]+[^[:space:]]+|--[A-Za-z-]+(=[^[:space:]]*)?|-[pP]))*[[:space:]]+commit([[:space:]]|$)'
if ! printf '%s\n' "$simple_commands" | grep -qE "$git_commit_re"; then
  exit 0
fi

# It was a git commit — check if we're in a git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  exit 0
fi

# Get the HEAD commit SHA
commit_sha=$(git rev-parse HEAD 2>/dev/null || echo "unknown")
short_sha=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")

# Check for scan evidence already in this session (avoid double-triggering)
# Look for scan-related commits made after our commit
scan_evidence="false"
if [ -f "findings.json" ] || [ -f "hawk_scan_output.json" ]; then
  scan_evidence="true"
fi
# Check if there's a very recent scan-related commit (within last 5 minutes)
if git log --since="5 minutes ago" --oneline 2>/dev/null | grep -iE "scan|hawkscan|security fix|vulnerability|resolve CWE" >/dev/null 2>&1; then
  scan_evidence="true"
fi

if [ "$scan_evidence" = "true" ]; then
  exit 0
fi

# Build the context injection
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

context_text="<hawkscan-post-commit>
Code committed at ${short_sha} (${commit_sha}). Invoke hawkscan:hawkscan to scan this commit. The scan results will be associated with commit ${short_sha}.

If the application is running and HAWK_API_KEY is set, run the scan now. Fix all findings, commit fixes, then rescan to verify.
</hawkscan-post-commit>"

escaped=$(escape_for_json "$context_text")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
