# Shell scripts run under bash, also on Windows (Git for Windows); CRLF line endings break
# them ("set: pipefail: invalid option name"). The installers copy stop.sh as checked out.
*.sh text eol=lf
# The extensionless Claude hook scripts are bash too. The .cmd wrapper keeps git's default
# line endings (core.autocrlf decides): cmd.exe can misread a batch file with LF line endings,
# and bash reads it only on systems that check out LF.
plugins/*/hooks/* text eol=lf
plugins/*/hooks/*.cmd !text !eol
# install.sh reads the legacy rule names line by line; a CR would end up in each name.
scripts/cursor-legacy-rules.txt text eol=lf
# The scripts rewrite the JSON manifests with LF (bump-version.sh stamps them, the generators
# write them), so a CRLF checkout would show each run as a change to every manifest.
*.json text eol=lf
# Generated files are compared byte for byte with what their generators write
# (scripts/generate-cursor-adapter.py --check, scripts/test-wingman-skills.sh), so they, the
# skills they copy, and the sources of the rules and Cursor hooks (cursor-src/) stay LF in
# every checkout, as the export (git archive) reads them.
plugins/*/skills/** text eol=lf
cursor-plugins/** text eol=lf
plugins/wingman/copilot-skills/** text eol=lf
cursor-src/** text eol=lf
